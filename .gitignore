# ==============================================================================
# Luna E-Commerce Microservices — Root .gitignore
# ==============================================================================

# Environment Variables & Secrets (never commit real credentials)
.env
.env.*
*.env
!.env.example

# Maven & Java Build Artifacts
target/
!.mvn/wrapper/maven-wrapper.jar
*.jar
*.war
*.ear
*.class
hs_err_pid*

# Node & Frontend
node_modules/
dist/
dist-ssr/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# IDEs & Editors
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/extensions.json
*.swp
*.swo

# OS Metadata
.DS_Store
Thumbs.db

