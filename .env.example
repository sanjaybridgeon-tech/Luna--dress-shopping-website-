# ==============================================================================
# Luna E-Commerce Microservices — Environment Variables
# ==============================================================================

# PostgreSQL Root Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# PostgreSQL Database Names
POSTGRES_PRODUCTS_DB=luna_products
POSTGRES_USERS_DB=luna_users
POSTGRES_ORDERS_DB=luna_orders

# Security & JWT Token Signing
# Note: In production, generate a secure 256-bit+ HMAC hex secret
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Public Exposed Host Ports
GATEWAY_PORT=8080
PRODUCT_SERVICE_PORT=8082
USER_SERVICE_PORT=8081
ORDER_SERVICE_PORT=8083
FRONTEND_PORT=80
FRONTEND_DEV_PORT=5173

# Database Host Mappings (for local external database inspection)
POSTGRES_PRODUCTS_PORT=5434
POSTGRES_USERS_PORT=5435
POSTGRES_ORDERS_PORT=5436
